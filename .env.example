# Copy to .env.local for `next dev`, and set the same values in your host's environment settings.
# Never commit real values.

# Shared site password (the first gate) and the cookie-signing secret (32+ random bytes, base64).
SITE_PASSWORD=change-me
AUTH_SECRET=

# Cloudflare R2 (S3 API): one bucket holds the AAC streams, covers, profiles and caches.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=music
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Voice DJ (optional): Gemini for speech understanding and TTS.
GEMINI_API_KEY=
VOICE_MODEL=gemini-3.1-flash-lite
TTS_MODEL=gemini-3.8-flash-lite-tts
# Daily caps per listener and in total; calls fail closed past them.
VOICE_DAILY_CALLS=200
VOICE_GLOBAL_DAILY_CALLS=600
TTS_DAILY_CALLS=100
TTS_GLOBAL_DAILY_CALLS=300

# Email sign-in links (optional): Resend.
RESEND_API_KEY=
EMAIL_FROM=Radio <noreply@example.com>
EMAIL_DAILY=5
EMAIL_GLOBAL_DAILY=50

# Acquisition source (optional): a worker that fetches requested songs. Bearer token it presents.
WORKER_TOKEN=
JOB_DAILY=20
JOB_GLOBAL_DAILY=60
